# Local authoring / runtime state -- NEVER tracked and NEVER shipped in a release.
# Default project data now lives outside the source tree (OS data dir); these
# entries only catch a legacy in-tree FORGE_PROJECT_ROOT override.
.forge_projects/
.recovery/
.trash/
.last_session.json

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Logs and milestone packets (built on demand, never committed).
#
# These used to be two filename globs sitting in the forge/ root. That was fragile
# in a way that actually bit: the globs are case-sensitive, so `WRL_PHASE3D_packet.zip`
# (lowercase "packet") slipped past `WRL_*_PACKET.zip` and was committed -- 69 KB of
# files that were themselves already tracked. Ignoring the DIRECTORY instead of
# guessing at filename spellings removes the whole class of miss.
*.log
packets/

# Built release artifacts
dist/
forge-release/
