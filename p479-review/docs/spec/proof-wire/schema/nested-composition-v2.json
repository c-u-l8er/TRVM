                 "films_below_by_edge_multiplicity": "DERIVED", "films_below_distinct": "DERIVED",
                 "cases_below_by_edge_multiplicity": "DERIVED", "cases_below_distinct": "DERIVED",
                 "structure_sem_id": "DERIVED" }
 },
